# Copy to .env and adjust. Values below match deploy/docker-compose.yml.

# API
NODE_ENV=development
API_PORT=3000

# PostgreSQL
DATABASE_URL=postgres://speaksplit:speaksplit@localhost:5432/speaksplit

# Redis (BullMQ, pub/sub, rate limits)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=speaksplit-receipts
S3_ACCESS_KEY_ID=speaksplit
S3_SECRET_ACCESS_KEY=speaksplit-secret
S3_FORCE_PATH_STYLE=true

# Auth0 (fill in when the tenant exists)
AUTH0_ISSUER_URL=https://login.example.com/
AUTH0_AUDIENCE=https://api.speaksplit.example.com
