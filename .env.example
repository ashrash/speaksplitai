# Copy to .env and adjust. Values below match deploy/docker-compose.yml.

# API
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# PostgreSQL
DATABASE_URL=postgres://speaksplit:speaksplit@localhost:5432/speaksplit

# Redis (BullMQ, pub/sub, rate limits)
REDIS_URL=redis://localhost:6379

# S3-compatible storage (MinIO locally)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=speaksplit-receipts
S3_ACCESS_KEY_ID=speaksplit
S3_SECRET_ACCESS_KEY=speaksplit-secret
S3_FORCE_PATH_STYLE=true

# Auth0 (required): the tenant or custom-domain URL with trailing slash, and the API identifier
AUTH0_ISSUER_URL=https://login.example.com/
AUTH0_AUDIENCE=https://api.speaksplit.example.com
# Optional: prefix of custom claims your Auth0 Action adds (email, email_verified)
AUTH0_CLAIM_NAMESPACE=https://speaksplit.example.com/
# Dev only: the Native app's Client ID, used by `pnpm --filter @speaksplit/api auth:login`
AUTH0_CLIENT_ID=

# Optional: base URL invite links point at (the web pay page or app link domain)
PUBLIC_APP_URL=https://pay.speaksplit.example.com

# Integration tests (pnpm test:int): a role that can create throwaway databases
TEST_DATABASE_URL=postgres://speaksplit:speaksplit@localhost:5432/speaksplit
