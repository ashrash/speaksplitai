{
  "name": "@speaksplit/api-types",
  "version": "0.0.0",
  "private": true,
  "description": "zod request/response schemas shared by the API and its clients.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@speaksplit/split-engine": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
