{
  "name": "@speaksplit/split-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Dependency-free split, balance and debt-simplification logic shared by the apps and the API.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "fast-check": "^4.0.0",
    "tsup": "^8.5.0"
  }
}
