{
  "name": "@speaksplit/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS + TypeORM REST API.",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migration:run": "typeorm migration:run -d dist/database/data-source.js",
    "migration:revert": "typeorm migration:revert -d dist/database/data-source.js",
    "migration:create": "typeorm migration:create",
    "test:int": "vitest run --config vitest.int.config.ts",
    "auth:check-token": "node --env-file-if-exists=../../.env dist/cli/check-token.js",
    "auth:login": "node --env-file-if-exists=../../.env dist/cli/login.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "@nestjs/typeorm": "^12.0.0",
    "@speaksplit/api-types": "workspace:*",
    "@speaksplit/split-engine": "workspace:*",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.3.1",
    "pg": "^8.16.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "typeorm": "^1.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.13.0",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "unplugin-swc": "^2.0.0"
  }
}
