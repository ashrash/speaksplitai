{
  "name": "speaksplit-pay",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" build",
    "test": "pnpm -r test",
    "test:int": "pnpm --filter @speaksplit/api test:int",
    "db:migrate": "pnpm --filter @speaksplit/api build && pnpm --filter @speaksplit/api migration:run",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose -f deploy/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f deploy/docker-compose.yml down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.0"
  }
}
